---

<div id="container">
  <div class="bg">
    {
      BACKGROUND_ICON_CONFIGS.map((icon) => (
        <Icon
          class="bg__icon"
          name={icon.icon}
          data-xx={icon.xx}
          data-xy={icon.xy}
          data-rotate={icon.rotate}
          style={`position:absolute;top:${icon.top};left:${icon.left};transform:rotate(${icon.rotate});color:${icon.color};`}
        />
      ))
    }
  </div>

  <div class="soc-media">
    {
      SOC_MEDIA_SVG.map((icon) => (
        <a
          class="soc-media__icon"
          href={icon.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={icon.name}
        >
          <Icon name={icon.icon} size="35" />
        </a>
      ))
    }
  </div>

  <main>
    <div class="info">
      <span class="info__hey">👋 hey there,</span>
      <span class="info__name">i'm Siarhei Chura</span>
      <span class="info__job">
        <span>a</span>
        <span class="info__job-title">Software Engineer</span>
        <span>mainly working with</span>
        <span>Angular</span>
      </span>
    </div>
  </main>
</div>

<script>
  const icons = Array.from(document.querySelectorAll<HTMLElement>('.bg__icon'));

  const onMove = (event: MouseEvent): void => {
    const x = (window.innerWidth - event.pageX * 3) / 50;
    const y = (window.innerHeight - event.pageY * 3) / 50;

    icons.forEach((icon) => {
      const xx = parseFloat(icon.dataset.xx || '0');
      const xy = parseFloat(icon.dataset.xy || '0');
      const rotate = icon.dataset.rotate || '0deg';

      icon.style.transform = `translateX(${x * xx}px) translateY(${y * xy}px) rotate(${rotate})`;
    });
  };

  document.addEventListener('mousemove', onMove);
</script>
